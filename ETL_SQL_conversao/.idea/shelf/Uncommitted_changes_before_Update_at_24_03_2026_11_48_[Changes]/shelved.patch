+# sql/extracao_funcionarios.py
+
+# A Query que define O QUE buscar
+SELECT_FUNC = """
+    SELECT 
+         f.codigofuncpessoa
+        ,fun.codigoempresa
+        ,fun.codigofunccontr
+        ,fun.nomefunc
+    FROM funcpessoa f 
+    JOIN funcionario fun on f.codigofuncpessoa = fun.codigofuncpessoa
+"""
+
+# O Mapeamento que define COMO transformar (De -> Para)
+MAPEAMENTO_COLUNAS = {
+    'codigofuncpessoa':  'codigoFunc'
+    ,'codigoempresa':  'codempresa'
+    ,'codigofunccontr': 'fucionarion'
+    ,'nomefunc': 'nomecolabrador'
+
+}
+
+# Configurações de destino
+TABELA_DESTINO = "funcionarios"
